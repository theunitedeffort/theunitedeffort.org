---
layout: "layouts/root.liquid"
---
<div class="docs-container">
	<aside class="left-sidebar">
	  <nav>
	    {{ collections.all | eleventyNavigation | eleventyNavigationToHtml: navOptions}}
	  </nav>
  </aside>
  <main data-pagefind-body>
    {{ content }}
  </main>

	<aside class="right-sidebar">
		{% if content | toc %}
		  <div class="sticky-toc">
		    <h4>On this page</h4>
		    {{ content | toc }}
		  </div>
		{% endif %}
  </aside>
</div>