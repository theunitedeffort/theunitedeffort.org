---
layout: "layouts/root.liquid"
---
<div class="docs-container">
	<aside class="left-sidebar">
	  <nav>
	    {{ cms.docs.pages | eleventyNavigation: cms.docs.rootNodeKey | eleventyNavigationToHtml: navOptions}}
	  </nav>
  </aside>

	  <main data-pagefind-body>
			{% assign breadcrumbs = cms.docs.pages | eleventyNavigationBreadcrumb: thisPage.url, navOptions %}
			<div class="article-header">
			  <nav class="breadcrumbs">
			  	{% if breadcrumbs.size > 1 %}
			    <ol>
			      {% for crumb in breadcrumbs %}
			        <li>
			          {% if crumb.url %}
			            <a href="{{ crumb.url }}">{{ crumb.title }}</a>
			          {% else %}
			            <span>{{ crumb.title }}</span>
			          {% endif %}
			        </li>
			      {% endfor %}
			    </ol>
			    {% endif %}
			  </nav>
			  <div class="search-wrapper"><pagefind-modal-trigger hide-shortcut></pagefind-modal-trigger></div>
			</div>
			<pagefind-modal></pagefind-modal>
			<div class="article-title">
			  <h1>{{ thisPage.name }}</h1>
			  <p>Last Updated {{ thisPage.lastUpdated | date: '%B %e, %Y' }}</p>
		  </div>
			<div class="content-wrapper">
				<div class="content-body">
		      {{ content }}
		    </div>
		    <aside class="right-sidebar">
				{% if content | toc %}
				  <div class="sticky-toc">
				    <h4>On this page</h4>
				    {{ content | toc }}
				  </div>
				{% endif %}
	  		</aside>
			</div>
	  </main>

  </div>
</div>