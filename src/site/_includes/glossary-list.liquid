<div class="glossary">
	<dl>
	{% for item in glossary %}
	  <dt id="{{ item.slug }}"><span class="bold">{{ item.term }}</span></dt>
	  {% if item.synonyms != empty %}<dd class="synonyms italic">Also known as {{ item.synonyms | map: 'term' | join: ', ' }}</dd>{% endif %}
	  <dd>{{ item.definition }}</dd>
	{% endfor %}
	</dl>
</div>