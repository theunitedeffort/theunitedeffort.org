<div class="glossary">
	<dl>
	{% for item in glossary %}
	  <dt id="{{ item.slug }}" class="bold">{{ item.term }}</dt>
	  <dd>{% if item.synonyms != empty %}<p class="italic">Also known as {{ item.synonyms | map: 'term' | join: ', ' }}</p>{% endif %}{{ item.definition }}</dd>
	{% endfor %}
	</dl>
</div>