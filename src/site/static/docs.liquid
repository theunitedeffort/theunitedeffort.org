---
layout: "layouts/docs.liquid"
pagination:
  data: cms.docs
  size: 1
  alias: thisPage
  addAllPagesToCollections: true
permalink: "{{ thisPage.url }}/index.html"
eleventyComputed:
  pageClass: "page{{ thisPage.url | replace: '/', '-' }}"
  title: "{{ thisPage.name }}"
  pageHead: '<link href="/pagefind/pagefind-component-ui.css" rel="stylesheet"><script src="/pagefind/pagefind-component-ui.js" type="module"></script>'
  navOptions:
    includeSelf: true
    activeAnchorClass: active-page
    activeKey: "{{ thisPage.data.eleventyNavigation.key }}"
    allowMissing: true
    useTopLevelDetails: true
  childPagesOptions:
    listClass: "child-pages"
---

{%- for section in thisPage.sections -%}
  <div class="{{ section.type | downcase }}">
    {% if section.type == "Process-Table" %}
      <div class="process-header-steps bold">Process Steps</div>
      <div class="process-header-who bold">Who</div>
      {% assign table = section.content | stepNumbers %}
      {% for step in table.steps %}
          <div class="process-step-number bold">#{{ forloop.index }}</div>
          <div class="process-step-wrapper">
            <div class="process-step-content">{{ step.content | markdownify }}</div>
            <div class="process-step-next">{{ step.next_step | markdownify }}</div>
          </div>
          <div class="process-step-who">{{ step.who }}</div>
      {% endfor %}
    {% elsif section.type == "Diagram" %}
      {{ section.content }}
    {% elsif section.type == "Include" %}
      {% include section.content %}
    {% else %}
      {% if section.content %}
        {{ section.content | markdownify | unplaceholder: cms.images }}
      {% endif %}
    {% endif %}
  </div>
{%- endfor -%}

<script>
  // TODO: can we do this statically at build-time?  Should be able to...
  const activePageAnchor = document.querySelector('.left-sidebar nav li a.active-page');
  if (activePageAnchor) {
    const activeTopParent = activePageAnchor.closest('.left-sidebar nav > ul > li');
    if (activeTopParent) {
      activeTopParent.querySelector('details').setAttribute('open', 'open');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const activeClass = 'active-section';
    const headings = Array.from(
      document.querySelectorAll('.docs-container main h2')
    );
    const tocLinks = document.querySelectorAll('.right-sidebar .toc a');

    if (!headings.length || !tocLinks.length) return;

    const setActive = (heading) => {
      if (!heading) return;
      const id = heading.getAttribute('id');
      tocLinks.forEach((link) => {
        link.parentElement.classList.toggle(activeClass, link.getAttribute('href') === `#${id}`);
      });
    };

    // Flag to prevent initial load entries from triggering false "scroll up" events
    // TODO: decide if this is needed.
    let isInitialized = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const index = headings.indexOf(entry.target);

        // heading exits from top -> make that heading active
        // heading exits from bottom -> make the previous heading active
        if (isInitialized && !entry.isIntersecting &&  entry.boundingClientRect.bottom < entry.rootBounds.top) {
          setActive(entry.target)
        } else if (isInitialized && !entry.isIntersecting && entry.boundingClientRect.top > entry.rootBounds.bottom) {
          if (index > 0) {
            setActive(headings[index - 1]);
          }
        }
      });
    }, {
      // Thresholds are offets from the top and bottom of the viewport
      rootMargin: '-10% 0px -60% 0px'
    });

    headings.forEach((heading) => observer.observe(heading));

    // Enable exit-direction logic after the initial load observer sweep
    setTimeout(() => {
      isInitialized = true;
    }, 100);
  });
</script>
