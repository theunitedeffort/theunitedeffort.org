---
layout: "layouts/docs.liquid"
pagination:
  data: cms.docs
  size: 1
  alias: thisPage
  addAllPagesToCollections: true
permalink: "{{ thisPage.url }}/index.html"
eleventyComputed:
  pageClass: "page{{ thisPage.url | replace: '/', '-' }}"
  title: "{{ thisPage.name }}"
  pageHead: "{{ thisPage.head }}"
  eleventyNavigation:
    key: "{{ thisPage.url }}"
    title: "{{ thisPage.name }}"
    parent: "{{ thisPage.parent }}"
  navOptions:
    includeSelf: true
    activeAnchorClass: active-page
    activeKey: "{{ eleventyNavigation.key }}"
---

{% assign breadcrumbs = collections.all | eleventyNavigationBreadcrumb: thisPage.url, navOptions %}
<nav class="breadcrumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {% for crumb in breadcrumbs %}
      <li><a href="{{ crumb.url }}">{{ crumb.title }}</a></li>
    {% endfor %}
  </ol>
</nav>

<h1>{{ thisPage.name }}</h1>
<p>Last Updated {{ thisPage.lastUpdated | date: '%B %e, %Y' }}</p>
{%- for section in thisPage.sections -%}
  <div class="{{ section.type | downcase }}">
    {% if section.type == "Process-Table" %}
      <div class="process-header-steps bold">Process Steps</div>
      <div class="process-header-who bold">Who</div>
      {% assign table = section.content | stepNumbers %}
      {% for step in table.steps %}
          <div class="process-step-number bold">#{{ forloop.index }}</div>
          <div class="process-step-wrapper">
            <div class="process-step-content">{{ step.content | markdownify }}</div>
            <div class="process-step-next">{{ step.next_step | markdownify }}</div>
          </div>
          <div class="process-step-who">{{ step.who }}</div>
      {% endfor %}
    {% elsif section.type == "Diagram" %}
      {{ section.content }}
    {% elsif section.type == "Include" %}
      {% include section.content %}
    {% else %}
      {% if section.content %}
        {{ section.content | markdownify | unplaceholder: cms.images }}
      {% endif %}
    {% endif %}
  </div>
{%- endfor -%}

<script>
  document.addEventListener('DOMContentLoaded', () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const activeClass = 'active-section';
      const id = entry.target.getAttribute('id');
      const tocLink = document.querySelector(`.right-sidebar .toc a[href="#${id}"]`);
      const tocItem = tocLink.parentElement;

      if (entry.isIntersecting && tocItem) {
        // Remove active class from all links
        document.querySelectorAll('.right-sidebar .toc li').forEach((item) => item.classList.remove(activeClass));
        // Highlight active link
        tocItem.classList.add(activeClass);
      }
    });
  }, {
    // Triggers when section reaches top 20% of the viewport
    rootMargin: '0px 0px -80% 0px'
  });

  // Observe all h2 and h3 elements inside your article
  document.querySelectorAll('.docs-container main h2').forEach((heading) => {
    observer.observe(heading);
  });
});
</script>
